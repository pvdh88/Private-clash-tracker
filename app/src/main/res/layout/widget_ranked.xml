<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingBottom="8dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/ranked_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="RANKED ATTACKS" android:textSize="16sp" android:textStyle="bold" android:fontFamily="sans-serif-condensed" android:textColor="#F2F5F7" android:maxLines="1"/>
            <TextView android:id="@+id/ranked_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ALL VILLAGES" android:textSize="10sp" android:textColor="#F2C46C" android:paddingTop="3dp" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <TextView android:id="@+id/ranked_settings" android:layout_width="44dp" android:layout_height="44dp" android:gravity="center" android:text="⚙" android:textSize="18sp" android:textColor="#F2F5F7" android:background="@drawable/widget_row_bg" android:layout_marginEnd="6dp" android:contentDescription="Clash API settings"/>
        <ImageView android:id="@+id/ranked_refresh" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_refresh" android:padding="12dp" android:background="@drawable/widget_row_bg" android:contentDescription="Fetch ranked attacks"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/ranked_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
    <TextView android:id="@+id/ranked_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No villages saved yet. Import one to start." android:textSize="12sp" android:textColor="#A4B0C1" android:padding="8dp" android:visibility="gone"/>
</LinearLayout>
